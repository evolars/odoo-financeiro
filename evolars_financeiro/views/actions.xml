<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="action_contas_receber" model="ir.actions.act_window">
        <field name="name">Contas a receber</field>
        <field name="res_model">account.move</field>
        <field name="path">contas-a-receber</field>
        <field name="view_mode">list,form,pivot,graph</field>
        <field name="view_id" ref="view_move_tree_financeiro" />
        <field name="domain">[('move_type', 'in', ('out_invoice', 'out_refund'))]</field>
        <field
            name="context"
        >{'default_move_type': 'out_invoice', 'search_default_evolars_em_aberto': 1}</field>
    </record>

    <record id="action_contas_pagar" model="ir.actions.act_window">
        <field name="name">Contas a pagar</field>
        <field name="res_model">account.move</field>
        <field name="path">contas-a-pagar</field>
        <field name="view_mode">list,form,pivot,graph</field>
        <field name="view_id" ref="view_move_tree_financeiro" />
        <field name="domain">[('move_type', 'in', ('in_invoice', 'in_refund'))]</field>
        <field
            name="context"
        >{'default_move_type': 'in_invoice', 'search_default_evolars_em_aberto': 1}</field>
    </record>

    <record id="action_vencimentos" model="ir.actions.act_window">
        <field name="name">Vencimentos</field>
        <field name="res_model">account.move.line</field>
        <field name="path">vencimentos</field>
        <field name="view_mode">list,pivot,graph</field>
        <field
            name="view_ids"
            eval="[(5, 0, 0),
                   (0, 0, {'view_mode': 'list', 'view_id': ref('account_due_list.view_payments_tree')}),
                   (0, 0, {'view_mode': 'pivot', 'view_id': ref('account_due_list.view_payments_pivot')}),
                   (0, 0, {'view_mode': 'graph', 'view_id': ref('account_due_list.view_payments_graph')})]"
        />
        <field name="search_view_id" ref="account_due_list.view_payments_filter" />
        <field
            name="domain"
        >[('account_id.reconcile', '=', True), ('balance', '!=', 0)]</field>
        <field
            name="context"
        >{'search_default_posted_moves': 1, 'search_default_from_invoices': 1, 'search_default_not_full_reconciled': 1, 'search_default_groupby_maturity_month': 1}</field>
    </record>

    <!-- Painel dos diários de banco e caixa: em cada cartão ficam "Importar
         extrato" e "Conciliar" (account_reconcile_oca). -->
    <record id="action_bancos" model="ir.actions.act_window">
        <field name="name">Bancos</field>
        <field name="res_model">account.journal</field>
        <field name="path">bancos</field>
        <field name="view_mode">kanban,form</field>
        <field name="view_id" ref="account.account_journal_dashboard_kanban_view" />
        <field name="domain">[('type', 'in', ('bank', 'cash'))]</field>
    </record>

    <record id="action_categorias" model="ir.actions.act_window">
        <field name="name">Categorias</field>
        <field name="res_model">account.account</field>
        <field name="view_mode">list,form</field>
        <field
            name="domain"
        >[('account_type', 'in', ('income', 'income_other', 'expense', 'expense_direct_cost'))]</field>
        <field name="help" type="html">
            <p>As categorias são as contas de resultado do plano de contas. O DRE
            agrupa cada uma pela etiqueta: ao criar uma categoria, copie as
            etiquetas de uma conta parecida.</p>
        </field>
    </record>

    <!-- Os relatórios do mis_builder abrem a instância na tela de resultado.
         Ação de janela, não ação de servidor: a ação de servidor que devolve um
         registro fixo, chamada pelo menu, deixa o roteador de URL em laço (no
         Odoo 19, de onde o módulo veio). Ao abrir pela URL o cliente ignora o
         res_id e o formulário nasce sem registro; o widget do mis_builder então
         lê a instância de active_model/active_id do contexto. -->
    <record id="action_fluxo_caixa" model="ir.actions.act_window">
        <field name="name">Fluxo de caixa</field>
        <field name="res_model">mis.report.instance</field>
        <field name="path">fluxo-de-caixa</field>
        <field name="res_id" eval="ref('mis_builder_cash_flow.mis_instance_cash_flow')" />
        <field
            name="context"
            eval="{'active_model': 'mis.report.instance', 'active_id': ref('mis_builder_cash_flow.mis_instance_cash_flow')}"
        />
        <field name="view_mode">form</field>
        <field name="view_id" ref="mis_builder.mis_report_instance_result_view_form" />
        <field name="target">current</field>
    </record>

    <record id="action_dre_mensal" model="ir.actions.act_window">
        <field name="name">DRE do mês</field>
        <field name="res_model">mis.report.instance</field>
        <field name="path">dre-mensal</field>
        <field name="res_id" eval="ref('l10n_br_mis_report.instance_dre_mensal')" />
        <field
            name="context"
            eval="{'active_model': 'mis.report.instance', 'active_id': ref('l10n_br_mis_report.instance_dre_mensal')}"
        />
        <field name="view_mode">form</field>
        <field name="view_id" ref="mis_builder.mis_report_instance_result_view_form" />
        <field name="target">current</field>
    </record>

    <record id="action_dre_exercicio" model="ir.actions.act_window">
        <field name="name">DRE do ano</field>
        <field name="res_model">mis.report.instance</field>
        <field name="path">dre-anual</field>
        <field name="res_id" eval="ref('l10n_br_mis_report.instance_dre_exercicio')" />
        <field
            name="context"
            eval="{'active_model': 'mis.report.instance', 'active_id': ref('l10n_br_mis_report.instance_dre_exercicio')}"
        />
        <field name="view_mode">form</field>
        <field name="view_id" ref="mis_builder.mis_report_instance_result_view_form" />
        <field name="target">current</field>
    </record>

    <record id="action_balanco" model="ir.actions.act_window">
        <field name="name">Balanço</field>
        <field name="res_model">mis.report.instance</field>
        <field name="path">balanco</field>
        <field name="res_id" eval="ref('l10n_br_mis_report.instance_bp_exercicio')" />
        <field
            name="context"
            eval="{'active_model': 'mis.report.instance', 'active_id': ref('l10n_br_mis_report.instance_bp_exercicio')}"
        />
        <field name="view_mode">form</field>
        <field name="view_id" ref="mis_builder.mis_report_instance_result_view_form" />
        <field name="target">current</field>
    </record>
</odoo>
